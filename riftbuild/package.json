{
  "name": "riftbuild",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:deno": "node scripts/sync-shared-to-deno.mjs",
    "check:sources": "node scripts/check-forbidden-sources.mjs",
    "contracts": "pnpm --filter @riftbuild/shared test -- contracts",
    "evals": "pnpm --filter @riftbuild/evals run evals",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm sync:deno --check && pnpm check:sources",
    "web:export": "node scripts/web-export.mjs",
    "web:smoke": "node scripts/web-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript-eslint": "^8.72.0",
    "prettier": "^3.9.10",
    "globals": "^16.0.0",
    "typescript": "~6.0.3"
  }
}
