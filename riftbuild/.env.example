# ---------------------------------------------------------------------------
# App (public, bundled into the app: never put secrets in EXPO_PUBLIC_*)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional override (dev/screenshots): defaults to <SUPABASE_URL>/storage/v1/object/public/catalog/manifest.json
EXPO_PUBLIC_CATALOG_MANIFEST_URL=
# Dev only: accept fixture bundles (shows "DADOS DE TESTE") / partial local bundles.
EXPO_PUBLIC_ALLOW_FIXTURES=0
EXPO_PUBLIC_ALLOW_PARTIAL=0

# ---------------------------------------------------------------------------
# Pipeline (GitHub Actions secrets)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Edge Functions (set with `supabase secrets set`, never in the app)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model IDs are required and are NOT hardcoded. Check current names at https://docs.claude.com
# before setting them. Candidates as of 2026-10: draft = claude-haiku-5-5 (fast; try
# claude-sonnet-5-5 if evals < 90%), review/tips = claude-opus-5-5.
AI_MODEL_DRAFT=
AI_MODEL_REVIEW=
AI_MODEL_TIPS=
AI_EFFORT_DRAFT=low
AI_EFFORT_REVIEW=medium
AI_MAX_TOKENS_DRAFT=8000
AI_TIMEOUT_MS_DRAFT=15000
AI_SCHEMA_ENUMS=true
AI_DAILY_LIMIT_DRAFT=30
AI_DAILY_LIMIT_REVIEW=10
AI_GLOBAL_DAILY_LIMIT=2000
RATE_LIMIT_SALT=
ALLOW_DEVICE_FALLBACK=0
