{
  "name": "@rotavix/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p . && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests --dir src",
    "e2e": "playwright test --trace off",
    "orcamento": "node scripts/orcamento.mjs",
    "icones": "pwa-assets-generator",
    "android:sync": "cap sync android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@protomaps/basemaps": "5.7.2",
    "@rotavix/data-format": "workspace:*",
    "@rotavix/router": "workspace:*",
    "@rotavix/ui": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "comlink": "4.4.2",
    "maplibre-gl": "6.18.0",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.0"
  }
}
